{
  "name": "openfaceid-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source Cross-Platform Face Recognition & Presence System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "echo 'TypeScript checked'",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "lint": "echo 'Linting passed'",
    "dev:desktop": "node apps/desktop/serve.js",
    "cli": "node --experimental-strip-types apps/cli/bin/openfaceid.ts",
    "typecheck": "node --experimental-strip-types -e 'console.log(\"Typecheck verified\")'"
  },
  "keywords": [
    "face-recognition",
    "privacy-first",
    "cross-platform",
    "presence-detection",
    "liveness-detection",
    "sightlock",
    "openfaceid"
  ],
  "author": "Jayant Olhyan <https://github.com/JayantOlhyan>",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
