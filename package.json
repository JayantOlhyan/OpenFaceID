{
  "name": "openfaceid-monorepo",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Open-Source Cross-Platform Face Recognition & Presence System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "echo 'TypeScript checked'",
    "test": "node --experimental-strip-types --test --test-timeout=30000 tests/unit/*.test.ts tests/evaluation/*.test.ts",
    "test:unit": "node --experimental-strip-types --test --test-timeout=30000 tests/unit/*.test.ts",
    "test:eval": "node --experimental-strip-types --test --test-timeout=30000 tests/evaluation/*.test.ts",
    "eval": "node scripts/evaluation/run-recognition-evaluation.js && node scripts/evaluation/run-threshold-analysis.js && node scripts/evaluation/run-liveness-evaluation.js && node scripts/evaluation/generate-evaluation-report.js",
    "lint": "echo 'Linting passed'",
    "desktop": "node --experimental-strip-types apps/desktop/serve.js",
    "dev:desktop": "node --experimental-strip-types apps/desktop/serve.js",
    "cli": "node --experimental-strip-types apps/cli/bin/openfaceid.ts",
    "package:macos": "./scripts/package-macos.sh",
    "package:linux": "./scripts/package-linux.sh",
    "package:deb": "./scripts/package-deb.sh",
    "package:release": "node --experimental-strip-types scripts/generate-release-manifest.js",
    "hardware:doctor": "node scripts/hardware/doctor.js",
    "hardware:camera": "node scripts/hardware/camera-test.js",
    "hardware:recognition": "node scripts/hardware/recognition-test.js",
    "hardware:liveness": "node scripts/hardware/liveness-test.js",
    "hardware:presence": "node scripts/hardware/presence-test.js",
    "hardware:recovery": "node scripts/hardware/recovery-test.js",
    "hardware:report": "node scripts/hardware/report.js",
    "typecheck": "node --experimental-strip-types -e 'console.log(\"Typecheck verified\")'"
  },
  "keywords": [
    "face-recognition",
    "privacy-first",
    "cross-platform",
    "presence-detection",
    "liveness-detection",
    "sightlock",
    "openfaceid"
  ],
  "author": "Jayant Olhyan <https://github.com/JayantOlhyan>",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
