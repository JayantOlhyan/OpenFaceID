# Enforce consistent LF line endings across all platforms to prevent CRLF corruption
* text=auto eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.swift text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Explicit binary files
*.bin binary
*.onnx binary
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.dmg binary
*.zip binary
